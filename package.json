{
  "name": "jail-information-system",
  "version": "1.0.0",
  "description": "Jail Information System - Desktop Standalone Application",
  "main": "main.js",
  "scripts": {
    "setup": "node setup_env.js",
    "postinstall": "node setup_env.js",
    "start": "cd backend && npm start",
    "install-backend": "cd backend && npm install",
    "install-frontend": "cd frontend && npm install",
    "install-all": "npm run install-backend && npm run install-frontend",
    "build": "npm run install-all && cd frontend && npm run build",
    "serve": "cd frontend && npx serve -s build -l 3000",
    "start-prod": "npm run build && npm run serve",
    "db:export": "node backend/scripts/exportDatabase.js",
    "db:import": "node backend/scripts/importDatabase.js",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "jail",
    "information",
    "system",
    "desktop",
    "electron",
    "sqlite",
    "mssql",
    "express"
  ],
  "author": "Your Name",
  "license": "MIT"
}